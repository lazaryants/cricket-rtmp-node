# Copy to /opt/cricket-rtmp-node/config/node.env and adjust as needed.
CRICKET_RTMP_ROOT=/opt/cricket-rtmp-node
CRICKET_RTMP_PUBLIC_HOST=rtmp.cricket-stream.icu
CRICKET_RTMP_HLS_ROOT=/var/www/hls
CRICKET_RTMP_LOCAL_HLS_ORIGIN=http://127.0.0.1/hls
CRICKET_RTMP_LOCAL_RTMP_ORIGIN=rtmp://127.0.0.1
CRICKET_RTMP_STAT_URL=http://127.0.0.1:8090/stat
CRICKET_RTMP_FFMPEG=/usr/bin/ffmpeg
CRICKET_RTMP_MANAGER_BIND=127.0.0.1:5000
CRICKET_RTMP_AUTH_BIND=127.0.0.1:8080
CRICKET_RTMP_MANAGER_THREADS=4
CRICKET_RTMP_MANAGER_TIMEOUT=30
CRICKET_RTMP_LOG_LEVEL=info

# Optional overrides. Defaults already point inside CRICKET_RTMP_ROOT.
# CRICKET_RTMP_CONFIG=/opt/cricket-rtmp-node/state/restream-config.json
# CRICKET_RTMP_RUN_DIR=/opt/cricket-rtmp-node/run
# CRICKET_RTMP_LOG_DIR=/opt/cricket-rtmp-node/logs
# CRICKET_RTMP_SUPERVISOR_SOCKET=/opt/cricket-rtmp-node/run/supervisor.sock
