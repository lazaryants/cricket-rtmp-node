server {
    listen 80;
    listen [::]:80;
    server_name @@SERVER_NAMES@@;

    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/letsencrypt;
        default_type text/plain;
        auth_basic off;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name @@SERVER_NAMES@@;

    ssl_certificate @@TLS_CERTIFICATE@@;
    ssl_certificate_key @@TLS_CERTIFICATE_KEY@@;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    root @@WEB_ROOT@@;
    index index.html;

    auth_basic "Restricted Access";
    auth_basic_user_file @@BASIC_AUTH_FILE@@;

    location /admin {
        proxy_pass http://@@MANAGER_UPSTREAM@@/;
        include proxy_params;
    }

    location /config/ {
        proxy_pass http://@@MANAGER_UPSTREAM@@/config/;
        include proxy_params;
    }

    location /admin/api/config/ {
        proxy_pass http://@@MANAGER_UPSTREAM@@/api/config/;
        include proxy_params;
    }

    location = /api/fields {
        proxy_pass http://@@MANAGER_UPSTREAM@@/api/config/fields;
        include proxy_params;
    }

    location /api/node/ {
        proxy_pass http://@@MANAGER_UPSTREAM@@/api/node/;
        include proxy_params;
    }

    location /admin/api/ {
        proxy_pass http://@@MANAGER_UPSTREAM@@/api/;
        include proxy_params;
    }

    location ~ ^/hls/place([1-9]|1[0-6])/([A-Za-z0-9_.-]+)$ {
        alias @@HLS_ROOT@@/place$1/$2;
        types {
            application/vnd.apple.mpegurl m3u8;
            video/mp2t ts;
        }
        add_header Cache-Control no-cache;
        add_header Access-Control-Allow-Origin *;
        expires -1;
        auth_basic off;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
